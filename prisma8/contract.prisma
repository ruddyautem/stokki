// use prisma-8
// Equivalent of the existing Prisma 7 Product schema. The database is not changed by emitting this contract.

namespace public {
  model Product {
    id         String                                                    @id @onCreate(cuid(2))
    userId     String
    name       String
    sku        String?
    price      Numeric(12, 2)
    quantity   Int                                                       @default(0)
    lowStockAt Int?
    createdAt  TimestampString(3)                                        @default(now())
    updatedAt  TimestampString(3)                                        @onCreate(now()) @onUpdate(now())

    @@index([userId, sku], map: "Product_userId_sku_key", unique: true)
    @@index([userId, name], map: "Product_userId_name_idx")
    @@index([createdAt], map: "Product_createdAt_idx")
  }
}
